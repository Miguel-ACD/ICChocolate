  "narrative": {
    "northStar": "Mesa de trabajo de repostería",
    "overview": "Una superficie luminosa de crema y papel con el cacao como tinta y acción. La interfaz es cálida y serena, pero sigue siendo una herramienta de operación: títulos expresivos, controles familiares, datos legibles y pasos de revisión explícitos. La marca aparece en el color, la tipografía y detalles pequeños, sin ilustración decorativa dominante. La familia cacao y crema es un compromiso de marca. En el escritorio, la opción manual recibe mayor contraste, la ruta con foto queda claramente disponible y la consulta del inventario permanece a la vista.",
    "keyCharacteristics": [
      "Papel claro, tinta cacao y acentos albaricoque y salvia.",
      "Fraunces para títulos; Segoe UI para operación y datos.",
      "Superficies amplias, bordes suaves y separación por tono.",
      "Estados y recorrido de confirmación visibles antes de cambiar existencias."
    ],
    "rules": [
      {
        "name": "The Semantic State Rule",
        "body": "Los colores de salvia y ámbar se reservan para estados de inventario y alertas; el cacao identifica la acción principal.",
        "section": "colors"
      },
      {
        "name": "The Two Voice Rule",
        "body": "Fraunces queda en títulos; Segoe UI carga instrucciones, controles, navegación y datos.",
        "section": "typography"
      },
      {
        "name": "The Flat Surface Rule",
        "body": "Paneles y tablas permanecen planos en reposo; reservar el relieve para interacción y superposición.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do mantener cacao y crema como base de cada pantalla nueva.",
      "Do hacer visible la revisión antes de la confirmación de cualquier movimiento.",
      "Do usar Fraunces en títulos y Segoe UI en los elementos operativos.",
      "Do mostrar alertas y estados reales con texto además de color."
    ],
    "donts": [
      "Don't usar salvia o ámbar como adornos que puedan confundirse con un estado.",
      "Don't convertir todos los paneles en tarjetas elevadas; la profundidad tiene una función.",
      "Don't presentar una propuesta de foto o IA como cambio de existencias confirmado."
    ]
  }
}
